# ==============================================================================
# DevSparks DeployCheck — Environment Configuration Template
# Copy this file to .env.local or .env for local development
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# Application & Server Port
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection
# In local development without Postgres, in-memory repository fallbacks are used.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploycheck_dev
DATABASE_MAX_POOL_SIZE=10
DATABASE_SSL=false

# Master Encryption Key (Used for AES-256-GCM BYOK cipher)
# Must be at least 32 characters in production.
DEPLOYCHECK_MASTER_ENCRYPTION_KEY=devsparks-deploycheck-dev-secret-salt-32b

# BYOK AI Provider Configuration (OpenRouter Adapter)
# Obtain your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_SITE_NAME=DevSparks DeployCheck
OPENROUTER_SITE_URL=http://localhost:3000

# Synthetic Monitoring & Probe Settings
MONITORING_DEFAULT_INTERVAL_SECONDS=60
MONITORING_PROBE_TIMEOUT_MS=5000
MONITORING_CONSECUTIVE_FAILURE_THRESHOLD=3

# Logging & Telemetry
LOG_LEVEL=info
